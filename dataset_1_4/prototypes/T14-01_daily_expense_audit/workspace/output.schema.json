{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "open_claims",
    "policy",
    "receipt_a",
    "receipt_b",
    "group_c",
    "payable_idr",
    "final"
  ],
  "properties": {
    "open_claims": {
      "type": "array",
      "description": "Unique active OPEN claim IDs sorted in ascending order.",
      "items": {
        "type": "string",
        "enum": [
          "E01",
          "E02",
          "E03",
          "E04"
        ]
      },
      "uniqueItems": true
    },
    "policy": {
      "type": "string",
      "enum": [
        "EXP-1",
        "EXP-2"
      ]
    },
    "receipt_a": {
      "type": "object",
      "description": "Printed whole-IDR fields transcribed from images/A.jpg.",
      "additionalProperties": false,
      "required": [
        "total_idr",
        "service_idr",
        "tax_idr"
      ],
      "properties": {
        "total_idr": {
          "type": "integer"
        },
        "service_idr": {
          "type": "integer"
        },
        "tax_idr": {
          "type": "integer"
        }
      }
    },
    "receipt_b": {
      "type": "object",
      "description": "Printed whole-IDR fields transcribed from images/B.jpg.",
      "additionalProperties": false,
      "required": [
        "total_idr",
        "cash_idr",
        "change_idr"
      ],
      "properties": {
        "total_idr": {
          "type": "integer"
        },
        "cash_idr": {
          "type": "integer"
        },
        "change_idr": {
          "type": "integer"
        }
      }
    },
    "group_c": {
      "type": "object",
      "description": "Printed purchase from images/C.jpg joined to records/attendance.csv for G7.",
      "additionalProperties": false,
      "required": [
        "purchased_servings",
        "approved_servings",
        "total_idr"
      ],
      "properties": {
        "purchased_servings": {
          "type": "integer"
        },
        "approved_servings": {
          "type": "integer"
        },
        "total_idr": {
          "type": "integer"
        }
      }
    },
    "payable_idr": {
      "type": "object",
      "description": "Active-row map of payable whole-IDR reimbursement for each included OPEN claim.",
      "additionalProperties": false,
      "properties": {
        "E01": {
          "type": "integer"
        },
        "E02": {
          "type": "integer"
        },
        "E03": {
          "type": "integer"
        },
        "E04": {
          "type": "integer"
        }
      }
    },
    "final": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_idr",
        "route"
      ],
      "properties": {
        "batch_idr": {
          "type": "integer"
        },
        "route": {
          "type": "string",
          "enum": [
            "RELEASE",
            "ESCALATE"
          ]
        }
      }
    }
  }
}
