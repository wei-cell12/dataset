{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "active_cards",
    "policy",
    "figure_a",
    "figure_b",
    "source_values",
    "final"
  ],
  "properties": {
    "active_cards": {
      "type": "array",
      "description": "Unique ACTIVE card IDs sorted in ascending order.",
      "items": {
        "type": "string",
        "enum": [
          "K1",
          "K2",
          "K3",
          "K4",
          "K5"
        ]
      },
      "uniqueItems": true
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tolerance_points"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "PUB-1",
            "PUB-2"
          ]
        },
        "tolerance_points": {
          "type": "integer"
        }
      }
    },
    "figure_a": {
      "type": "object",
      "description": "Two 2016 domestic-economy-good integer percentage readings from images/A.jpg.",
      "additionalProperties": false,
      "required": [
        "us_2016_pct",
        "japan_2016_pct"
      ],
      "properties": {
        "us_2016_pct": {
          "type": "integer"
        },
        "japan_2016_pct": {
          "type": "integer"
        }
      }
    },
    "figure_b": {
      "type": "object",
      "description": "Two Bad economic-ties integer percentage readings (2019 and 2020) from images/B.jpg.",
      "additionalProperties": false,
      "required": [
        "bad_2019_pct",
        "bad_2020_pct"
      ],
      "properties": {
        "bad_2019_pct": {
          "type": "integer"
        },
        "bad_2020_pct": {
          "type": "integer"
        }
      }
    },
    "source_values": {
      "type": "object",
      "description": "Active-row map of integer source-derived values in the units and subtraction order printed in records/cards.csv.",
      "additionalProperties": false,
      "properties": {
        "K1": {
          "type": "integer"
        },
        "K2": {
          "type": "integer"
        },
        "K3": {
          "type": "integer"
        },
        "K4": {
          "type": "integer"
        },
        "K5": {
          "type": "integer"
        }
      }
    },
    "final": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audited",
        "accepted",
        "corrections",
        "decision"
      ],
      "properties": {
        "audited": {
          "type": "integer"
        },
        "accepted": {
          "type": "integer"
        },
        "corrections": {
          "type": "array",
          "description": "Failing active card IDs sorted in ascending order.",
          "items": {
            "type": "string",
            "enum": [
              "K1",
              "K2",
              "K3",
              "K4",
              "K5"
            ]
          },
          "uniqueItems": true
        },
        "decision": {
          "type": "string",
          "enum": [
            "RETURN",
            "RELEASE"
          ]
        }
      }
    }
  }
}
